# circos.conf

karyotype = fcp_100kb_karyotype

chromosomes_units = 100000
chromosomes_display_default = no
chromosomes = utg000012l;utg000025l;utg000001l;utg000027l;utg000006l;utg000005l;utg000015l;utg000033l;utg000003l;utg000016l;utg000018l;utg000023l;utg000009l;utg000019l;utg000004l;utg000036l;utg000040l;utg000045l;utg000052l;utg000024l;utg000022l;utg000065l;utg000014l;utg000044l;utg000021l;utg000038l;utg000011l;utg000047l;utg000034l;utg000056l;utg000013l;utg000037l;utg000051l;utg000053l;utg000058l;utg000032l;utg000054l;utg000048l;utg000002l;utg000026l;utg000035l;utg000007l;utg000028l;utg000059l;utg000039l;utg000078l;utg000090l;utg000061l;utg000067l;utg000062l;utg000057l;utg000010l;utg000076l;utg000041l;utg000020l;utg000050l;utg000064l;utg000070l;chr1
chromosomes_order = utg000012l;utg000025l;utg000001l;utg000027l;utg000006l;utg000005l;utg000015l;utg000033l;utg000003l;utg000016l;utg000018l;utg000023l;utg000009l;utg000019l;utg000004l;utg000036l;utg000040l;utg000045l;utg000052l;utg000024l;utg000022l;utg000065l;utg000014l;utg000044l;utg000021l;utg000038l;utg000011l;utg000047l;utg000034l;utg000056l;utg000013l;utg000037l;utg000051l;utg000053l;utg000058l;utg000032l;utg000054l;utg000048l;utg000002l;utg000026l;utg000035l;utg000007l;utg000028l;utg000059l;utg000039l;utg000078l;utg000090l;utg000061l;utg000067l;utg000062l;utg000057l;utg000010l;utg000076l;utg000041l;utg000020l;utg000050l;utg000064l;utg000070l;chr1

<ideogram>

<spacing>
default = 0.01r
</spacing>

radius    = 0.6r
thickness = 20p
fill      = yes

show_label     = yes
label_radius   = dims(ideogram,radius_outer) + 10p
label_font     = default
label_size     = 24p
label_parallel = no

</ideogram>

<plots>
<plot>
show =yes
type = scatter
file = fcp_species_weighted_fst
extend_bin = yes
thickness = 1
r1          = 0.54r
r0          = 0.44r
orientation = out
max   = 1.0
min   = 0.0
glyph            = circle
glyph_size       = 6

<rules>
<rule>
condition    = var(value) < 0.24
stroke_color = bupu-9-seq-3
fill_color   = bupu-9-seq-3
</rule>

<rule>
condition    = var(value) > 0.24
stroke_color = bupu-9-seq-7
fill_color   = bupu-9-seq-7
</rule>
</rules>

<axes>
<axis>
color     = grey
thickness = 1
spacing   = 0.1r
y0        = 0.00
</axis>
</axes>

</plot>

<plot>
show =yes
type = scatter
file = fcp_pi
extend_bin = yes
thickness = 1
r1          = 0.8r
r0          = 0.7r
orientation = out
max   = 0.02
min   = 0.0
glyph            = circle
glyph_size       = 6

<axes>
<axis>
color     = grey
thickness = 1
spacing   = 0.1r
y0        = 0.00
</axis>
</axes>

<rules>
<rule>
condition    = var(value) < 0.005
stroke_color = oranges-9-seq-3
fill_color   = oranges-9-seq-3
</rule>

<rule>
condition    = var(value) > 0.005
stroke_color = oranges-9-seq-7
fill_color   = oranges-9-seq-7

</rule>
</rules>

</plot>

<plot>
show =yes
type = scatter
file = fcp_snpden_end
extend_bin = yes
thickness = 1
r1          = 0.93r
r0          = 0.83r
orientation = out
max   = 60
min   = 0.0
glyph            = circle
glyph_size       = 6



<rules>
<rule>
condition    = var(value) < 30
stroke_color = ylgn-9-seq-3
fill_color   = ylgn-9-seq-3

</rule>

<rule>
condition    = var(value) > 30
stroke_color = ylgn-9-seq-7
fill_color   = ylgn-9-seq-7

</rule>
</rules>

<axes>
<axis>
color     = grey
thickness = 1
spacing   = 0.1r
y0        = 0.00
</axis>
</axes>

</plot>

<plot>
show =yes
type = scatter
file = fcp_tajd_end
extend_bin = yes
thickness = 1
r1          = 0.67r
r0          = 0.57r
orientation = out
max   = 6.3
min   = 0.0
glyph            = circle
glyph_size       = 6



<rules>
<rule>
condition    = var(value) < 3
stroke_color = purples-9-seq-4
fill_color   = purples-9-seq-4

</rule>

<rule>
condition    = var(value) > 3
stroke_color = purples-9-seq-7
fill_color   = purples-9-seq-7

</rule>
</rules>

<axes>
<axis>
color     = grey
thickness = 1
spacing   = 0.1r
y0        = 0.00
</axis>
</axes>

</plot>



</plots>

<highlights>

z          = 0
#fill_color = green

<highlight>
file       = fcp_effector.bed
r0         = 0.99r
r1         = 0.95r
fill_color = bugn-9-seq-6
</highlight>
<highlight>
file       = fcp_telo.bed
r0         = 0.99r
r1         = 0.95r
fill_color = rdpu-9-seq-5
</highlight>

</highlights>





